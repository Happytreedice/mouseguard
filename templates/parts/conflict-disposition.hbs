<div class="mouse_conflict">
    <h2>{{localize "MOUSEGUARD.Conflict.DispositionTitle" team=teamLabel}}</h2>
    <div class="form-group" style="margin-bottom: 8px;">
        <label for="conflict_dispo_starting" style="display: block; margin-bottom: 4px; font-weight: bold;">
            {{localize "MOUSEGUARD.Sheet.DispositionStarting"}}
        </label>
        <input type="number" id="conflict_dispo_starting" name="starting" value="{{disposition.starting}}" min="1" max="99" step="1" required style="width: 100%; box-sizing: border-box;" />
        <p class="notes" style="font-size: 11px; color: #888; margin-top: 4px;">
            {{localize "MOUSEGUARD.Conflict.DispositionStartingHint"}}
        </p>
    </div>
    <div class="form-group" style="margin-bottom: 8px;">
        <label for="conflict_dispo_current" style="display: block; margin-bottom: 4px; font-weight: bold;">
            {{localize "MOUSEGUARD.Sheet.DispositionCurrent"}}
        </label>
        <input type="number" id="conflict_dispo_current" name="current" value="{{disposition.current}}" min="0" max="99" step="1" required style="width: 100%; box-sizing: border-box;" />
    </div>
</div>
