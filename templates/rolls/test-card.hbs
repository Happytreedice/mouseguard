<div class="mouseguard-chat mg-test-card">
    <header class="mg-card-header">
        <div class="mg-card-title">{{title}}</div>
        <div class="mg-card-kind">{{kind}}{{#if rollLabel}} · {{rollLabel}}{{/if}}</div>
    </header>

    <ul class="mg-pills">
        {{#each parts}}
        <li class="mg-pill {{kind}}"><span class="mg-pill-label">{{label}}</span><span class="mg-pill-value">{{value}}</span></li>
        {{/each}}
    </ul>

    <div class="mg-card-pool">{{localize "MOUSEGUARD.Test.Card.Pool" n=pool}}</div>
    <ol class="mg-dice">
        {{#each dice}}
        <li class="mg-die {{cls}}" data-tooltip="{{title}}"><img src="{{img}}" alt="{{title}}" width="28" height="28"></li>
        {{/each}}
    </ol>

    <div class="mg-outcome {{outcomeClass}}">
        <div class="heading">
            <span class="mg-outcome-icon"><i class="fa-solid {{outcomeIcon}}"></i></span>
            <span>{{heading}}</span>
        </div>
        <p class="mg-outcome-label">{{outcomeLabel}}{{#if marginText}} · {{marginText}}{{/if}}</p>
    </div>

    {{#if notes.length}}
    <ul class="mg-card-notes">
        {{#each notes}}<li>{{this}}</li>{{/each}}
    </ul>
    {{/if}}
    {{#if hints.length}}
    <ul class="mg-card-hints">
        {{#each hints}}<li><i class="fa-solid fa-circle-info"></i> {{this}}</li>{{/each}}
    </ul>
    {{/if}}

    {{#if actions.length}}
    <div class="mg-test-actions">
        {{#each actions}}
        <button type="button" class="mg-roll-button" data-mg-action="{{action}}" data-tooltip="{{hint}}">
            <i class="{{icon}}"></i> {{label}}
        </button>
        {{/each}}
    </div>
    {{/if}}
</div>
