{{!-- Left column (copy of the character portrait): portrait fading into the sheet background, name and subtitle overlaid. --}}
<aside class="mgs-portrait-col {{#if editMode}}is-editing{{/if}}" {{#if portrait.cloakSwatch}}style="--mgs-cloak: {{portrait.cloakSwatch}};"{{/if}}>
    <div class="mgs-portrait-frame">
        <img class="mgs-portrait {{#if portrait.isIcon}}is-icon{{/if}}" src="{{portrait.src}}" alt="{{actor.name}}"
             {{#if editMode}}data-action="editImage" data-edit="img" data-tooltip="MOUSEGUARD.Sheet.ChangePortrait"{{/if}}>
    </div>

    <div class="mgs-namecard">
        {{#if editMode}}
        {{!-- Only the name is edited here: the other details are inputs on the Description tab (one input per field). --}}
        <div class="mgs-identity-form">
            <input class="mgs-name-input" type="text" name="name" value="{{actor.name}}"
                   placeholder="{{localize "MOUSEGUARD.Sheet.Name"}}" aria-label="{{localize "MOUSEGUARD.Sheet.Name"}}">
            {{#if portrait.subtitle}}<div class="mgs-subtitle">{{portrait.subtitle}}</div>{{/if}}
            <div class="mgs-ident-hint">{{localize "MOUSEGUARD.NPCSheet.IdentityHint"}}</div>
        </div>
        {{else}}
        <h1 class="mgs-name">{{actor.name}}</h1>
        {{#if portrait.subtitle}}<div class="mgs-subtitle">{{portrait.subtitle}}</div>{{/if}}
        {{#if keyCharacter}}
        <div class="mgs-key-mark" data-tooltip="MOUSEGUARD.NPCSheet.KeyCharacterHint">
            <i class="fa-solid fa-star" inert></i> {{localize "MOUSEGUARD.NPCSheet.KeyCharacter"}}
        </div>
        {{/if}}
        {{#if portrait.cloak}}
        <div class="mgs-cloak" data-tooltip="MOUSEGUARD.Sheet.CloakColor">
            <span class="mgs-cloak-swatch {{#unless portrait.cloakSwatch}}is-unknown{{/unless}}"></span>
            <span class="mgs-cloak-text">{{localize "MOUSEGUARD.Sheet.CloakPrefix"}} {{portrait.cloak}}</span>
        </div>
        {{/if}}
        {{/if}}
    </div>
</aside>
