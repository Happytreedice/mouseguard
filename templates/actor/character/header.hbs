{{!-- Header strip: action buttons (Legend in the Mist roll buttons) and two white paper boxes (its "Tags & Statuses" box). --}}
<header class="mgs-header {{#if editMode}}is-editing{{/if}}">
  <div class="mgs-header-grid">
    <div class="mgs-actions">
        <button type="button" class="mgs-roll-button" data-action="testFree" data-tooltip="MOUSEGUARD.Sheet.TestHint">
            <i class="fa-solid fa-dice-d6" inert></i> {{localize "MOUSEGUARD.Sheet.Test"}}
        </button>
        <button type="button" class="mgs-roll-button mgs-quick-toggle {{#if quickMode}}active{{/if}}" data-action="toggleQuick"
                aria-pressed="{{#if quickMode}}true{{else}}false{{/if}}" data-tooltip="MOUSEGUARD.Sheet.QuickTestHint">
            <i class="fa-solid {{#if quickMode}}fa-toggle-on{{else}}fa-toggle-off{{/if}}" inert></i> {{localize "MOUSEGUARD.Sheet.QuickTest"}}
        </button>
        <button type="button" class="mgs-roll-button" data-action="newSession" data-tooltip="MOUSEGUARD.Sheet.NewSessionHint">
            <i class="fa-solid fa-hourglass-start" inert></i> {{localize "MOUSEGUARD.Sheet.NewSession"}}
        </button>
    </div>

    <section class="mgs-note mgs-conditions">
        <h3 class="mgs-subhead">{{localize "MOUSEGUARD.Sheet.Conditions"}}</h3>
        <div class="mgs-chips">
            <span class="mgs-chip mgs-chip--healthy {{#if healthy}}active{{/if}}" data-tooltip="MOUSEGUARD.Sheet.HealthyHint">
                <i class="fa-solid fa-heart" inert></i> {{localize "MOUSEGUARD.Sheet.Healthy"}}
            </span>
            {{#each conditions}}
            <a class="mgs-chip {{#if active}}active{{/if}}" data-action="toggleCondition" data-condition="{{key}}"
               data-tooltip="{{tooltip}}" role="button" tabindex="0" aria-pressed="{{#if active}}true{{else}}false{{/if}}">
                <img class="mgs-chip-icon" src="{{icon}}" alt=""> {{localize label}}
            </a>
            {{/each}}
        </div>
    </section>

    <section class="mgs-note mgs-rewards">
        <h3 class="mgs-subhead">{{localize "MOUSEGUARD.Sheet.Rewards"}}</h3>
        <div class="mgs-reward-grid">
            {{#each rewards}}
            <div class="mgs-reward">
                {{#if @root.editMode}}
                <input class="mgs-reward-input" type="number" name="{{path}}" value="{{value}}" min="0" max="99" step="1"
                       aria-label="{{localize label}}">
                {{else}}
                <a class="mgs-reward-value" data-action="adjust" data-path="{{path}}" data-min="0" data-max="99"
                   data-tooltip="{{tooltip}}" role="button" tabindex="0">{{value}}</a>
                {{/if}}
                <span class="mgs-reward-label">{{localize label}}</span>
            </div>
            {{/each}}
        </div>
        <div class="mgs-dispo" data-tooltip="MOUSEGUARD.Sheet.DispositionHint">
            <span class="mgs-dispo-label">{{localize "MOUSEGUARD.Sheet.Disposition"}}</span>
            {{#if editMode}}
            <input type="number" name="system.disposition.current" value="{{disposition.current}}" min="0" step="1"
                   aria-label="{{localize "MOUSEGUARD.Sheet.DispositionCurrent"}}">
            <span class="mgs-dispo-sep">/</span>
            <input type="number" name="system.disposition.starting" value="{{disposition.starting}}" min="0" step="1"
                   aria-label="{{localize "MOUSEGUARD.Sheet.DispositionStarting"}}">
            {{else}}
            <a class="mgs-dispo-value" data-action="adjust" data-path="system.disposition.current" data-min="0" data-max="99"
               role="button" tabindex="0">{{disposition.current}}</a>
            <span class="mgs-dispo-sep">/</span>
            <span class="mgs-dispo-start">{{disposition.starting}}</span>
            {{/if}}
        </div>
    </section>
  </div>
</header>
