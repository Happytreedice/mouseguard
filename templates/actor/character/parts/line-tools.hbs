{{!-- Edit-mode controls at the end of an item row (the row carries data-item-id). --}}
<span class="mgs-line-tools">
    <a class="mgs-tool" data-action="itemEdit" data-tooltip="MOUSEGUARD.Sheet.EditItem" role="button" tabindex="0"
       aria-label="{{localize "MOUSEGUARD.Sheet.EditItem"}}"><i class="fa-solid fa-pen-to-square" inert></i></a>
    <a class="mgs-tool" data-action="itemDelete" data-tooltip="MOUSEGUARD.Sheet.DeleteItem" role="button" tabindex="0"
       aria-label="{{localize "MOUSEGUARD.Sheet.DeleteItem"}}"><i class="fa-solid fa-trash" inert></i></a>
</span>
