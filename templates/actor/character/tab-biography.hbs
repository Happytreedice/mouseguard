{{!-- Biography tab: details, contacts, biography text (Legend in the Mist biography paper). --}}
<section class="tab mgs-tab-body mgs-tab-biography {{tab.cssClass}} {{#if editMode}}is-editing{{/if}}" data-tab="biography" data-group="primary">
    <div class="mgs-bio-grid">
        <div class="mgs-paper mgs-details">
            <h3 class="mgs-with-line">{{localize "MOUSEGUARD.Sheet.Details"}}</h3>
            <dl class="mgs-detail-list">
                {{#each details as |detail|}}
                <div class="mgs-detail mgs-detail--{{detail.key}}">
                    <dt><label for="{{@root.partId}}-{{detail.key}}">{{localize detail.label}}</label></dt>
                    <dd>
                        {{#if @root.editMode}}
                        <input id="{{@root.partId}}-{{detail.key}}" type="{{#if detail.type}}{{detail.type}}{{else}}text{{/if}}"
                               name="{{detail.name}}" value="{{detail.value}}" {{#if detail.type}}step="1"{{/if}}>
                        {{else}}
                        <span class="mgs-detail-value {{#unless detail.value}}is-empty{{/unless}}">{{#if detail.value}}{{detail.value}}{{else}}&mdash;{{/if}}</span>
                        {{/if}}
                    </dd>
                </div>
                {{/each}}
                <div class="mgs-detail mgs-detail--player">
                    <dt><label for="{{@root.partId}}-player">{{localize "MOUSEGUARD.Sheet.Player"}}</label></dt>
                    <dd>
                        {{#if editMode}}
                        <input id="{{@root.partId}}-player" type="text" name="system.player" value="{{system.player}}">
                        {{else}}
                        <span class="mgs-detail-value {{#unless system.player}}is-empty{{/unless}}">{{#if system.player}}{{system.player}}{{else}}&mdash;{{/if}}</span>
                        {{/if}}
                    </dd>
                </div>
            </dl>
        </div>

        <article class="mgs-card mgs-card--contacts">
            <h2 class="mgs-ribbon mgs-ribbon--orange">
                <span class="mgs-ribbon-title">{{localize "MOUSEGUARD.Sheet.Contacts"}}</span>
                {{#if editMode}}
                {{> "systems/mouseguard/templates/actor/character/parts/ribbon-tools.hbs" type="contact" create="MOUSEGUARD.Sheet.CreateContact"}}
                {{else}}<i class="mgs-ribbon-icon fa-solid fa-address-book" inert></i>{{/if}}
            </h2>
            <ol class="mgs-lines mgs-contacts" data-item-type="contact">
                {{#each contacts as |contact|}}
                <li class="mgs-contact draggable" data-item-id="{{contact.id}}">
                    <div class="mgs-contact-main">
                        <a class="mgs-line-name" data-action="itemEdit" role="button" tabindex="0"
                           data-tooltip="MOUSEGUARD.Sheet.OpenHint">{{contact.name}}</a>
                        {{#if @root.editMode}}{{> "systems/mouseguard/templates/actor/character/parts/line-tools.hbs"}}{{/if}}
                    </div>
                    {{#if contact.excerpt}}<p class="mgs-excerpt">{{contact.excerpt}}</p>{{/if}}
                </li>
                {{else}}
                <li class="mgs-empty">{{localize "MOUSEGUARD.Sheet.EmptyContacts"}}</li>
                {{/each}}
            </ol>
        </article>
    </div>

    <div class="mgs-paper mgs-prose mgs-biography">
        <h3 class="mgs-with-line">{{localize "MOUSEGUARD.Sheet.Biography"}}</h3>
        {{#if editable}}
        <prose-mirror name="system.biography" toggled value="{{system.biography}}" data-document-uuid="{{actor.uuid}}">
            {{{biographyHTML}}}
        </prose-mirror>
        {{else}}
        <div class="mgs-prose-content">{{{biographyHTML}}}</div>
        {{/if}}
    </div>
</section>
