<div class="mouse-combat-tracker plain directory-list">
    {{#each teams as |team teamKey|}}
    <div class="combat-team-block" data-team="{{ team.id }}">
        <div class="combat-team-header flexrow" data-team="{{ team.id }}">
            <h3 class="team-title noborder">{{ team.label }}</h3>
            {{#if team.goal}}
            <span class="team-goal-text" data-tooltip="{{ team.goal }}">{{ team.goal }}</span>
            {{/if}}

            {{#if (ne team.id "0")}}
            <div class="team-disposition-block flexrow">
                <span class="team-dispo-label">{{localize "MOUSEGUARD.Sheet.Disposition"}}:</span>
                {{#if team.hasDisposition}}
                    {{#if team.canAdjust}}
                    <button type="button" class="team-dispo-btn minus" data-action="adjustDisposition" data-team="{{ team.id }}" data-delta="-1" data-tooltip="{{ localize 'MOUSEGUARD.DispositionMinus' }}" aria-label="{{ localize 'MOUSEGUARD.DispositionMinus' }}">
                        <i class="fa-solid fa-minus" inert></i>
                    </button>
                    {{/if}}
                    <span class="team-dispo-value {{#if team.isZero}}is-zero{{/if}}">
                        <strong>{{ team.disposition.current }}</strong>&sol;{{ team.disposition.starting }}
                    </span>
                    {{#if team.canAdjust}}
                    <button type="button" class="team-dispo-btn plus" data-action="adjustDisposition" data-team="{{ team.id }}" data-delta="1" data-tooltip="{{ localize 'MOUSEGUARD.DispositionPlus' }}" aria-label="{{ localize 'MOUSEGUARD.DispositionPlus' }}">
                        <i class="fa-solid fa-plus" inert></i>
                    </button>
                    <button type="button" class="team-dispo-btn edit" data-action="setDisposition" data-team="{{ team.id }}" data-tooltip="{{ localize 'MOUSEGUARD.Conflict.EditDisposition' }}" aria-label="{{ localize 'MOUSEGUARD.Conflict.EditDisposition' }}">
                        <i class="fa-solid fa-pen-to-square" inert></i>
                    </button>
                    {{/if}}
                {{else}}
                    {{#if team.canAdjust}}
                    <button type="button" class="team-dispo-set-btn" data-action="setDisposition" data-team="{{ team.id }}" data-tooltip="{{ localize 'MOUSEGUARD.Conflict.SetDisposition' }}">
                        <i class="fa-solid fa-plus" inert></i> {{ localize "MOUSEGUARD.Conflict.SetDisposition" }}
                    </button>
                    {{else}}
                    <span class="team-dispo-empty">{{ localize "MOUSEGUARD.Conflict.NoDisposition" }}</span>
                    {{/if}}
                {{/if}}
            </div>
            {{/if}}
        </div>

        <ol class="combat-tracker plain team-combatant-list" data-team="{{ team.id }}">
            {{#each team.turns}}
            <li class="combatant {{ css }}" data-combatant-id="{{ id }}" data-team="{{ team }}" draggable="{{ @root.user.isGM }}">
                {{!-- Image --}}
                <img class="token-image" src="{{ img }}" alt="{{ name }}" loading="lazy" data-action="activateCombatant">

                {{!-- Name & Controls --}}
                <div class="token-name flexcol" data-action="activateCombatant">
                    <div class="combatant-name-row flexrow">
                        <strong class="name">{{ name }}</strong>
                        {{#if isConflictCaptain}}
                        <i class="fa-solid fa-crown conflict-captain-icon" style="color: #ffd700;" data-tooltip="{{ localize 'COMBAT.IsConflictCaptain' }}"></i>
                        {{/if}}
                    </div>

                    <div class="combatant-controls flexrow">
                        {{#if @root.user.isGM}}
                        <button type="button" class="inline-control combatant-control icon fa-solid fa-eye-slash {{#if hidden}}active{{/if}}"
                                data-action="toggleHidden" data-tooltip aria-label="{{ localize (ifThen hidden "COMBATANT.Show" "COMBATANT.Hide") }}"></button>
                        <button type="button" class="inline-control combatant-control icon fa-solid fa-skull {{#if isDefeated}}active{{/if}}"
                                data-action="toggleDefeated" data-tooltip aria-label="{{ localize (ifThen isDefeated "COMBATANT.UnmarkDefeated" "COMBATANT.MarkDefeated") }}"></button>
                        {{/if}}
                        {{#if canPing}}
                        <button type="button" class="inline-control combatant-control icon fa-solid fa-bullseye-arrow"
                                data-action="pingCombatant" data-tooltip aria-label="{{ localize 'COMBATANT.Ping' }}"></button>
                        {{/if}}
                        {{#unless @root.user.isGM}}
                        <button type="button" class="inline-control combatant-control icon fa-solid fa-arrows-to-eye"
                                data-action="panToCombatant" data-tooltip aria-label="{{ localize 'COMBATANT.PanTo' }}"></button>
                        {{/unless}}

                        <div class="token-effects" data-tooltip-html="{{ effects.tooltip }}">
                            {{#each effects.icons}}
                            <img class="token-effect" src="{{ img }}" alt="{{ name }}">
                            {{/each}}
                        </div>
                    </div>
                </div>

                {{!-- Moves --}}
                {{#if moves.length}}
                <div class="combatant-moves-container flexrow">
                    {{#each moves}}
                    <div class="combatant-move-item">
                        {{#if (or @root.user.isGM ../isOwner)}}
                            {{#if (and @root.user.isGM (and ../hasPlayerOwner (not ../isOwner)))}}
                            <img src="systems/mouseguard/assets/card.svg" class="card-icon" data-tooltip="{{ localize 'COMBAT.HiddenMove' }}" height="24" width="18" />
                            {{else}}
                            <button type="button" class="combatant-move-btn" data-action="doMove" data-move-id="{{ id }}" data-combatant-id="{{ ../id }}" data-tooltip="{{ localize (concat 'COMBAT.' move) }}">
                                {{ localize (concat 'COMBAT.' move) }}
                            </button>
                            {{/if}}
                        {{else}}
                        <img src="systems/mouseguard/assets/card.svg" class="card-icon" height="24" width="18" />
                        {{/if}}
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{!-- Resource --}}
                {{#if resource includeZero=true}}
                <div class="token-resource">
                    <span class="resource">{{ resource }}</span>
                </div>
                {{/if}}
            </li>
            {{else}}
            <li class="team-empty-placeholder" data-team="{{ team.id }}">
                <span class="empty-note">{{ localize "COMBAT.DragDropTeam" }}</span>
            </li>
            {{/each}}
        </ol>
    </div>
    {{/each}}
</div>
